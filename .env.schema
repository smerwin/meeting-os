# @defaultSensitive=true @defaultRequired=false
# ---

# Powers person/company enrichment via Brave Search. Get a key at
# https://brave.com/search/api/. Required for `loadPerson`/enrichment to work;
# without it those RPCs no-op (see server.ts's braveSearch).
# @required
# @docs(https://brave.com/search/api/)
BRAVE_API_KEY=

# Needed to authenticate the AI binding's remote proxy (wrangler.jsonc sets
# `ai.remote: true`, so even local dev calls real Workers AI). Not required
# here: an interactive `wrangler login` works just as well and is the default
# for local host dev. Set this instead when running headless/non-interactively
# (e.g. in Docker), where there's no browser to complete the OAuth flow.
# @docs(https://developers.cloudflare.com/fundamentals/api/get-started/create-token/)
CLOUDFLARE_API_TOKEN=
